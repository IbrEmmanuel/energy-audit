# Postgres (required on Vercel — use Neon / Vercel Postgres / Supabase)
# Local example after creating a Neon DB:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js / NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google OAuth (Web client)
# Local redirect:  http://localhost:3000/api/auth/callback/google
# Vercel redirect: https://YOUR-APP.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

